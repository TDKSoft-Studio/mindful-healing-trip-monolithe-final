# Environment variables - documented template.
# Copy to .env.local for local development (task setup does this automatically).
# NEVER commit .env or .env.local - see .gitignore.

# --- Database (Prisma / PostgreSQL) ---------------------------------------
# Local dev value matches compose.yaml. These are development credentials
# only and must never be reused in production (contract §24/§28).
DATABASE_URL="postgresql://mindfultrip:devpassword@localhost:5432/mindfultrip?schema=public"

# --- Site identity ----------------------------------------------------------
# Canonical production domain, confirmed 2026-08-13 (contract §47). Used for
# canonical URLs, sitemap, Open Graph, JSON-LD, and absolute links.
# Use http://localhost:3000 for local development.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# --- Contact --------------------------------------------------------------
# Confirmed 2026-08-13. Used as the reply-to / display address for the
# contact form and footer (contract §17/§42).
CONTACT_EMAIL="info-healingtrip@nextgen-care.org"

# --- Email delivery (contact form, Phase 5) --------------------------------
# Local dev: Mailpit (see compose.yaml), no auth required.
# Production: set to the real SMTP provider's credentials via the deployment
# environment - never hardcode secrets here or in code (contract §27/§36).
SMTP_HOST="localhost"
SMTP_PORT="1025"
SMTP_USER=""
SMTP_PASSWORD=""
