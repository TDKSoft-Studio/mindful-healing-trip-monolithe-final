# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/playwright-report
/test-results
/blob-report

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (never commit real secrets - .env.example is the documented template)
.env
.env.local
.env.*.local
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# prisma generated client (regenerated by `prisma generate` / task setup)
/src/generated/prisma

# editor / AI tooling artifacts fetched locally (e.g. `prisma init` skills mirror)
# not part of the application - safe to delete and re-fetch, never committed
/.agents/
/.claude/skills/
/.windsurf/
skills-lock.json
