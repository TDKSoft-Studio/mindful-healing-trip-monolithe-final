// Prisma schema - Mindful Healing Trips
// See ARCHITECTURE.md for the Prisma v7 driver-adapter setup this relies on.

generator client {
  provider = "prisma-client-js"
  // output   = "../src/generated/prisma"  // Commenté pour utiliser l'emplacement par défaut
}

datasource db {
  provider = "postgresql"
  // La propriété `url` a été déplacée vers prisma.config.ts
}

/// Mirrors src/lib/trip-status.ts's TripStatus union exactly (contract §9) -
/// that file owns the display labels and booking rules, this owns storage.
/// Keep both in sync if a value is ever added/removed.
enum TripStatus {
  DRAFT
  UPCOMING
  OPEN
  LIMITED
  SOLD_OUT
  CLOSED
  COMPLETED
  CANCELLED
}

/// contract §9 (Destination) + §15 (destination pages).
model Destination {
  id               String @id @default(cuid())
  slug             String @unique
  name             String
  country          String
  shortDescription String
  description      String @db.Text

  /// No real destination photography has been supplied yet - nullable
  /// rather than a placeholder path, so it's obvious in the data that a
  /// real asset is still needed (TODO_ASSET, contract §21/§45).
  heroImage            String?
  gallery              String[] @default([])
  highlights           String[] @default([])
  practicalInformation String?  @db.Text

  /// Distinct from Trip's publishedAt - contract §9 lists "published
  /// status" for Destination specifically as a boolean.
  published Boolean @default(false)

  seoTitle       String?
  seoDescription String?

  trips Trip[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([published])
}

/// contract §9 (Trip) + §13/§14 (status display, trip page structure).
model Trip {
  id               String @id @default(cuid())
  slug             String @unique
  title            String
  shortDescription String
  description      String @db.Text

  destinationId String
  destination   Destination @relation(fields: [destinationId], references: [id])

  startDate DateTime
  endDate   DateTime
  /// Free-text duration as shown to visitors (e.g. "8 jours / 7 nuits") -
  /// kept separate from start/endDate because flyers phrase it as
  /// marketing copy, not always a clean date-math derivation.
  duration  String

  status TripStatus @default(DRAFT)

  coverImage           String? // TODO_ASSET: no real cover photo supplied yet.
  gallery              String[] @default([])
  highlights           String[] @default([])
  experiences          String[] @default([])
  practicalInformation String?  @db.Text
  included             String[] @default([])
  excluded             String[] @default([])

  /// Nullable + no invented default: most seeded trips have no confirmed
  /// price (contract §10 - never turn a visual guess into a hard number).
  price    Decimal? @db.Decimal(10, 2)
  currency String   @default("EUR")

  bookingUrl  String?
  bookingMode String? // e.g. "Contact direct" when there's no online flow.

  /// Per-trip override; falls back to site-config's contact when null.
  contactInformation String? @db.Text

  seoTitle       String?
  seoDescription String?

  publishedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  contactRequests ContactRequest[]

  @@index([destinationId])
  @@index([status])
}

/// Contact form submissions (contract §17/§59). Stored so a request isn't
/// lost if the confirmation email fails to send, and so Phase 7's admin
/// can eventually review them - not just emailed and forgotten.
model ContactRequest {
  id        String  @id @default(cuid())
  firstName String
  lastName  String
  email     String
  /// Optional - the contract lists it as a form field but forcing a phone
  /// number for a simple question is unnecessary friction (contract §44:
  /// clarté > décoration doesn't excuse avoidable friction either).
  phone     String?

  tripId            String?
  trip              Trip?   @relation(fields: [tripId], references: [id], onDelete: SetNull)
  participantsCount Int?

  message String @db.Text

  /// Timestamp the visitor gave consent (contract §17) - its presence
  /// *is* the record that consent was obtained, not a boolean.
  consentAt DateTime

  createdAt DateTime @default(now())

  @@index([tripId])
  @@index([createdAt])
}
